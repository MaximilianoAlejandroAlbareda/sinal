{
  "name": "sinal",
  "private": true,
  "version": "0.1.6",
  "description": "Compartilhamento de tela e streaming de jogos entre amigos, estilo Discord",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "server": "node server/cli.js",
    "app": "vite build && electron .",
    "app:dev": "electron .",
    "package": "vite build && electron-builder --win",
    "package:dir": "vite build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.sinal.desktop",
    "productName": "Sinal",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sinal",
      "artifactName": "Sinal-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Sinal-portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "process-audio-capture": "^1.0.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "45.5.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
